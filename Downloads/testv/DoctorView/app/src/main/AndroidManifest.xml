<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for Firebase (Auth, Firestore, Realtime Database, Storage) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DoctorViewApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoctorView">

        <!-- Splash: the first screen the user sees -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DoctorView.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Role selection (shown when logged out) -->
        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="false" />

        <!-- Patient auth -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Patient main screen with bottom navigation -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Doctor auth -->
        <activity
            android:name=".activities.DoctorLoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.DoctorRegisterActivity"
            android:exported="false" />

        <!-- Doctor dashboard -->
        <activity
            android:name=".activities.DoctorMainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
